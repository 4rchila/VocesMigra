# Plantilla de variables de entorno para Voces Migra.
# Copia este archivo a .env con valores locales y sintéticos. No versiones .env.
# Las variables se leen del entorno del proceso; no se cargan automáticamente.

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Ruta del admin (obligatoria en producción, no puede ser "admin").
DJANGO_ADMIN_URL=
# Producción: orígenes https que envían formularios, p. ej. https://tu-dominio.tech
DJANGO_CSRF_TRUSTED_ORIGINS=
# Proxies delante de la app: 0 en local, 1 en producción.
TRUSTED_PROXY_COUNT=
# Cabecera de IP que reescribe el proveedor; en producción por defecto
# HTTP_X_VERCEL_FORWARDED_FOR. Vacío en local.
CLIENT_IP_HEADER=

# Desarrollo y pruebas (SQLite). Vacío usa BASE_DIR/db.sqlite3.
SQLITE_PATH=

# Producción (PostgreSQL/Supabase). No incluir valores reales en este archivo.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require

# Correo. En desarrollo se usa la consola.
DJANGO_EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_USE_TLS=
DEFAULT_FROM_EMAIL=
